# ==============================================================================
# .gitignore: k8s-guard / k8s-detection-lab
# Threat Detection Lab & Automation
# ==============================================================================

# ------------------------------------------------------------------------------
# Security Telemetry & Generated Logs
# ------------------------------------------------------------------------------
# Prevent committing high-volume or sensitive audit/runtime telemetry logs
*.log
logs/**/*.log
/logs/audit/*
!/logs/audit/.gitkeep
/events.json
/events.txt
/var/log/

# ------------------------------------------------------------------------------
# Kubernetes & Cluster Credentials
# ------------------------------------------------------------------------------
# Prevent credential leakage if kubeconfig is exported locally
kubeconfig
*.kubeconfig
kubeconfig.yaml
.kube/

# ------------------------------------------------------------------------------
# Python Artifacts & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Helm & Package Archives
# ------------------------------------------------------------------------------
*.tgz
charts/*.tgz
.helm/

# ------------------------------------------------------------------------------
# Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~

# IDEs & Text Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp

# ------------------------------------------------------------------------------
# Scratch & Local Test Workspaces
# ------------------------------------------------------------------------------
scratch/
tmp/
